<?xml version="1.0"?>
<package format="2">
  <name>ligo</name>
  <version>1.0.0</version>
  <description>
    LIGO: Tightly coupled LiDAR-Inertial-GNSS odometry based on a hierarchy fusion
    framework for global localization with real-time mapping.
  </description>

  <maintainer email="hdj65822@connect.hku.hk">Dongjiao He</maintainer>
  <author email="hdj65822@connect.hku.hk">Dongjiao He</author>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>tf</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen_conversions</depend>
  <depend>livox_ros_driver</depend>
  <depend>gnss_comm</depend>
  <depend>sophus</depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosbag</test_depend>
</package>
